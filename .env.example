# Export these variables in Terminal; this package does not automatically load .env files.
DERIBIT_ENVIRONMENT=testnet
# BTC, ETH, or ANY for both BTC and ETH across supported product types.
DERIBIT_CURRENCY=ANY
DERIBIT_DATABASE_URL=sqlite:///data/deribit.db
DERIBIT_SNAPSHOT_INTERVAL=30
DERIBIT_STALE_SECONDS=120
# Public subscriptions; raw requires authentication and is not supported here.
DERIBIT_TICKER_INTERVAL=100ms
# realtime keeps latest delivered tickers; 2s saves completed local quote OHLC buckets.
DERIBIT_FEED_MODE=realtime
